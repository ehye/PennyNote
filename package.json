{
  "name": "pennynote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "imports": { "#lib/*": "./src/lib/*" },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply pennynote --local",
    "db:migrate:production": "wrangler d1 migrations apply pennynote --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.0.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": { "@esbuild-kit/core-utils": { "esbuild": "^0.28.1" } },
  "engines": { "node": ">=22.17.0" }
}
